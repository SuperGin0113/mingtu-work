# Milvus (required)
TEST_MILVUS_HOST=
TEST_MILVUS_PORT=19530
TEST_MILVUS_USER=
TEST_MILVUS_PASSWORD=
# TEST_MILVUS_TOKEN=
# MILVUS_COLLECTION=chunks_test

# Embedding service (OpenAI-compatible /v1/embeddings, required)
EMBED_URL=http://host:port/v1/embeddings
EMBED_MODEL=bge-m3
# EMBED_TIMEOUT=60
# EMBED_BATCH_SIZE=20
# TOKENIZER_MODEL=BAAI/bge-m3

# Rerank service (optional; OpenAI-compatible /v1/rerank)
# RERANK_URL=http://host:port/v1/rerank
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_TIMEOUT=60

# HuggingFace mirror (tokenizer download on first run)
# HF_ENDPOINT=https://hf-mirror.com

# Uvicorn
# PORT=8080
# UVICORN_RELOAD=0

# Westlaw 登录凭证（spider 用）
WESTLAW_USERNAME=
WESTLAW_PASSWORD=

# MongoDB（spider 新流程；本地无 auth）
MONGO_URI=mongodb://localhost:27017
MONGO_DB=westlaw_spider
